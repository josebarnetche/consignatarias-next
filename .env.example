# ─────────────────────────────────────────────────────────────────────────────
# consignatarias.com.ar — environment variables
#
# Copy to `.env.local` for local dev and set the real values in Vercel for
# production. Never commit real secrets. NEXT_PUBLIC_* are exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.consignatarias.com.ar
NEXT_PUBLIC_BASE_URL=https://www.consignatarias.com.ar
# NODE_ENV is set automatically by Next/Vercel (development | production)

# ── Supabase ─────────────────────────────────────────────────────────────────
# Client (browser, RLS-scoped):
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Server (writes, bypasses RLS — keep secret):
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Secret that signs the Supabase auth webhook (/api/webhooks/auth):
SUPABASE_AUTH_WEBHOOK_SECRET=<webhook-secret>

# ── Cron & internal auth ─────────────────────────────────────────────────────
# CRON_SECRET is THE shared secret for every cron route (data AND email). The
# GitHub Actions workflows send it as `Authorization: Bearer ${{ secrets.CRON_SECRET }}`.
# It MUST be identical in GitHub repo secrets and in Vercel. ← single source of truth.
CRON_SECRET=<long-random-string>
# ADMIN_SECRET — DEPRECATED. Email crons used to require this; they now accept
# CRON_SECRET via authorizeCron(). Leave unset, or set equal to CRON_SECRET.
# (Historical gotcha: ADMIN_SECRET unset = email crons 401'd silently. See RUNBOOK.)
ADMIN_SECRET=
# Bearer secret for the GH Actions → /api/internal/cron-hook bridge (cron_runs logging):
INTERNAL_API_SECRET=<long-random-string>
# Inbox for admin notifications (claims, arrepentimiento, etc.):
ADMIN_EMAIL=agro@memola.com.ar

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Required to send ANY email. Without it, all send functions no-op silently.
RESEND_API_KEY=re_<key>
# Verified domain is consignatarias.com only:
RESEND_FROM_EMAIL=Consignatarias <noreply@consignatarias.com>
RESEND_FROM_PERSONAL=José Barnetche <hola@consignatarias.com>
# Per-run cap for the Resend free plan (100/day, 3000/mo). Default 80.
RESEND_DAILY_BATCH_CAP=80
# Bearer token for the El Corredor monthly blast (/api/el-corredor/blast):
EL_CORREDOR_BLAST_TOKEN=<long-random-string>

# ── API keys & hashing ───────────────────────────────────────────────────────
# Pepper for hashing Enterprise API keys (cnsg_live_*). NEVER rotate without
# invalidating every issued key.
API_KEY_PEPPER=<long-random-string>
# Pepper for hashing reviewer IPs (anti-abuse on reviews):
REVIEW_IP_PEPPER=<long-random-string>
# Internal API key used by server-side tasks that call the public API:
CONSIGNATARIAS_API_KEY=<cnsg_live_key>

# ── Payments (Rebill) ────────────────────────────────────────────────────────
REBILL_SECRET_KEY=<rebill-secret>
REBILL_WEBHOOK_SECRET=<rebill-webhook-secret>   # HMAC verification of webhooks
REBILL_USER_PRO_AMOUNT=7900                      # PRO Usuario ARS/mes
REBILL_ENTERPRISE_STARTER_AMOUNT=74000     # ARS/mes (opcional; default 74000). NO poner USD.
REBILL_PRO_PLAN_ID=<plan-id>
REBILL_FRIGO_PLAN_ID=<plan-id>
REBILL_STARTER_PLAN_ID=<plan-id>
REBILL_GROWTH_PLAN_ID=<plan-id>
REBILL_SCALE_PLAN_ID=<plan-id>

# ── External APIs ────────────────────────────────────────────────────────────
# YouTube Data API — matches consignataria channels for live-stream detection:
YOUTUBE_API_KEY=<youtube-api-key>

# ── Scripts only (NOT Vercel runtime) ────────────────────────────────────────
# Used by scripts/ (scrapers, backfills) when run locally/CI, not by the app:
#   BASE         base URL the script targets
#   CONCURRENCY  parallel workers
#   LIMIT        max items to process

# ── x402 (pagos por consulta en USDC para agentes) ───────────────────────────
# Sin estas vars el sistema queda APAGADO: /api/x402/* responde 503 y los tools
# MCP de valuación solo ofrecen el cupo diario gratis (sin mencionar pago).
#   X402_PAYTO_ADDRESS    wallet EVM (Base) que recibe los USDC
#   X402_NETWORK          "base-sepolia" (testeo, default) | "base" (mainnet)
#   X402_FACILITATOR_URL  default https://x402.org/facilitator (base-sepolia);
#                         mainnet: facilitator de Coinbase CDP
#   X402_FACILITATOR_AUTH opcional, header Authorization hacia el facilitator
X402_PAYTO_ADDRESS=
X402_NETWORK=base-sepolia
#   CDP_API_KEY_ID + CDP_API_KEY_SECRET  claves del portal de Coinbase Developer
#     Platform (portal.cdp.coinbase.com → API keys → Secret API key). Con ambas
#     presentes, el facilitator pasa a ser el de Coinbase (mainnet) con JWT
#     firmado por request. Para cobro real: además X402_NETWORK=base.
