{
  "git": {
    "deploymentEnabled": {
      "main": true,
      "dev": false
    }
  },
  "ignoreCommand": "bash scripts/ignore-build.sh",
  "crons": [],
  "functions": {
    "src/app/api/**/route.ts": {
      "memory": 256,
      "maxDuration": 30
    },
    "src/app/api/cron/**/route.ts": {
      "memory": 512,
      "maxDuration": 60
    },
    "src/app/api/webhooks/**/route.ts": {
      "memory": 256,
      "maxDuration": 15
    },
    "src/app/**/opengraph-image.tsx": {
      "memory": 1024,
      "maxDuration": 30
    },
    "src/app/**/twitter-image.tsx": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/alertas",
      "destination": "/planes",
      "permanent": false
    },
    {
      "source": "/:path((?!_next|api|favicon|robots|sitemap|manifest|icon|og).*)*",
      "has": [
        {
          "type": "host",
          "value": "consignatarias.com.ar"
        }
      ],
      "destination": "https://www.consignatarias.com.ar/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
